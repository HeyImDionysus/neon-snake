{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neon-snake-realtime",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "vars": {
    "APP_ORIGIN": "https://neon-snake-green-tau.vercel.app",
    "APP_API_ORIGIN": "https://neon-snake-green-tau.vercel.app"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
