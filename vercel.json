{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/realtime.mjs": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/downloads/v1.1.2/Neon-Snake-Lively-v1.1.2.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Neon-Snake-Lively-v1.1.2.zip\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/downloads/v1.1.1/Neon-Snake-Android-v1.1.1.apk",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Neon-Snake-Android-v1.1.1.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/downloads/v1.1.1/Neon-Snake-Lively-v1.1.1.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Neon-Snake-Lively-v1.1.1.zip\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/downloads/v1.1.0/Neon-Snake-Lively-v1.1.0.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Neon-Snake-Lively-v1.1.0.zip\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/downloads/v1.1.0/Neon-Snake-Android-v1.1.0.apk",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Neon-Snake-Android-v1.1.0.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://cdn.discordapp.com data: blob:; media-src 'self' blob:; connect-src 'self' https://discord.com wss://*.vercel.app wss://*.discordsays.com; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors https://discord.com https://*.discord.com; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), gamepad=(self), clipboard-write=(self), fullscreen=(self)"
        }
      ]
    }
  ]
}
